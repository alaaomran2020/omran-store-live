+          violations = [
+              p.get("id")
+              for p in products
+              if not (
+                  p.get("active") is True
+                  and p.get("workflowStatus") == "PUBLISHED"
+                  and p.get("qaStatus") == "PASS"
+              )
+          ]
+          assert not violations, (
+              f"Publication Gate violated, non-public products leaked: {violations[:10]}"
+          )
+
+          ids = [p.get("id") for p in products]
+          assert len(ids) == len(set(ids)), "Duplicate product ids in public payload."
+
+          print(
