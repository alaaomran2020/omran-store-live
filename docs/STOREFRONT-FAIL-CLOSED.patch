+async function fetchEngine(url, method, signal) {
+  const response = await fetch(url, {
+    method,
+    headers: { accept: 'application/json' },
+    signal,
+    redirect: 'follow',
+  });
+  const text = await response.text();
+  let body = null;
+  try {
+    body = text ? JSON.parse(text) : null;
+  } catch {
+    body = null;
+  }
+  return { response, body, source: url };
+}
 
