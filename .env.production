# ---------------------------------------------------------------------------
# Omran Toys — قيم بناء الواجهة (Vite يقرأ هذا الملف عند `vite build` فقط).
#
# لماذا هذا الملف موجود؟
#   `/api/products` على نفس الأصل هو المصدر الأساسي (يجيب عليه Cloudflare
#   Worker من الشيت). لكن إذا اختل هذا المسار (route قديم، أصل متعطل…)،
#   يسقط المتصفح تلقائيًا على قراءة الشيت المنشور مباشرةً — انظر
#   client/src/lib/productsClient.ts (fromPublishedCsv).
#   هذا لا يعمل إلا إذا كان الرابط مدمجًا في البناء وقت release.
#
# الرابط أدناه عام بالتصميم (Publish to web → CSV) وليس سرًّا — وهو نفسه
# PRODUCTS_SHEET_URL في wrangler.toml. مصدر الحقيقة الوحيد للشيت، فحدّثهما معًا.
# ---------------------------------------------------------------------------

# رابط Google Sheet المنشور كـCSV (ورقة products).
VITE_PRODUCTS_SHEET_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vTLph4MyfmoeWcjJ3cMi-iDaM3dgt4_S57SvKr6wpQu8IbDKliduguIcvtp7E5o0ZoxN3ouNQoZo7dn/pub?gid=57015348&single=true&output=csv

# رقم واتساب المتجر (يُستخدم في buildWhatsAppUrl عند غياب VITE_WHATSAPP_NUMBER وقت التشغيل)
VITE_WHATSAPP_NUMBER=201555570269
