                  {
                      "parameters":  {
                                         "jsCode":  "const headers = [\n  \u0027id\u0027,\u0027name\u0027,\u0027price\u0027,\u0027category\u0027,\u0027description\u0027,\u0027image\u0027,\u0027active\u0027,\u0027sort_order\u0027,\n  \u0027product_prompt\u0027,\u0027workflow_status\u0027,\u0027qa_status\u0027,\u0027source_drive_id\u0027,\n  \u0027processed_image\u0027,\u0027review_reason\u0027,\u0027sku\u0027,\u0027age_min\u0027,\u0027age_max\u0027\n];\n\nconst escapeCsv = (value) =\u003e {\n  if (value === null || value === undefined) return \u0027\u0027;\n  const text = String(value);\n  if (/[\",\\n\\r]/.test(text)) {\n    return `\"${text.replace(/\"/g, \u0027\"\"\u0027)}\"`;\n  }\n  return text;\n};\n\nconst rows = $input.all()\n  .map(i =\u003e i.json)\n  .filter(r =\u003e\n    String(r.active || \u0027\u0027).toUpperCase() === \u0027TRUE\u0027 \u0026\u0026\n    String(r.workflow_status || \u0027\u0027).toUpperCase() === \u0027PUBLISHED\u0027 \u0026\u0026\n    String(r.qa_status || \u0027\u0027).toUpperCase() === \u0027PASS\u0027 \u0026\u0026\n    String(r.id || \u0027\u0027).trim() \u0026\u0026\n    String(r.name || \u0027\u0027).trim() \u0026\u0026\n    String(r.image || \u0027\u0027).trim()\n  )\n  .map(r =\u003e ({\n    id: r.id,\n    name: r.name,\n    price: r.price ?? \u0027\u0027,\n    category: r.category || \u0027\u0027,\n    description: r.description || \u0027\u0027,\n    image: r.image || \u0027\u0027,\n    active: \u0027TRUE\u0027,\n    sort_order: r.sort_order || \u0027\u0027,\n    product_prompt: r.product_prompt || \u0027\u0027,\n    workflow_status: \u0027PUBLISHED\u0027,\n    qa_status: \u0027PASS\u0027,\n    source_drive_id: r.source_drive_id || \u0027\u0027,\n    processed_image: r.processed_image || \u0027\u0027,\n    review_reason: r.review_reason || \u0027\u0027,\n    sku: r.sku || \u0027\u0027,\n    age_min: r.age_min ?? \u0027\u0027,\n    age_max: r.age_max ?? \u0027\u0027\n  }))\n  .sort((a,b) =\u003e String(a.id).localeCompare(String(b.id)));\n\nconst lines = [\n  headers.join(\u0027,\u0027),\n  ...rows.map(row =\u003e headers.map(h =\u003e escapeCsv(row[h])).join(\u0027,\u0027))\n];\n\nconst text = lines.join(\u0027\\n\u0027) + \u0027\\n\u0027;\n\nreturn [{\n  json: {\n    count: rows.length,\n    content_b64: Buffer.from(text, \u0027utf8\u0027).toString(\u0027base64\u0027),\n    commit_message: `chore(catalog): sync ${rows.length} approved products`\n  }\n}];"
                                     },
