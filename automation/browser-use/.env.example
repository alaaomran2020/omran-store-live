# Preferred: one Browser Use key can route supported models.
BROWSER_USE_API_KEY=

# Optional provider-specific alternatives.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Defaults for Omran automation.
OMRAN_STORE_URL=https://omrantoys.store
OMRAN_BROWSER_MODEL=openai/gpt-5.5
OMRAN_BROWSER_MAX_STEPS=20

# Comma-separated extra domains explicitly approved for read-only research.
# omrantoys.store and www.omrantoys.store are always included.
OMRAN_BROWSER_ALLOWED_DOMAINS=
