# Omran Store Live — static storefront environment template
# Production storefront: Vite + Cloudflare Pages + Google Sheet/public snapshot.
# No VPS, MySQL, Docker, Tunnel, custom application server, or custom auth API.

# Public Google Sheet CSV used by the browser-side product loader when enabled.
# This is a public read-only URL, not a secret.
VITE_PRODUCTS_SHEET_URL=

# WhatsApp store number in international format without "+".
# Leave empty to hide WhatsApp ordering CTA instead of rendering a broken link.
VITE_WHATSAPP_NUMBER=

# Public Google Apps Script Web App URL used only to upsert VIP subscribers
# into the central "المشتركون" sheet. No API key or Google credential belongs here.
VITE_SUBSCRIBERS_WEB_APP_URL=

# Admin authentication is handled by Cloudflare Access at the edge.
# Do not add usernames, passwords, tokens, or auth endpoints to VITE_* variables.

# Optional: comma-separated Cloudflare Access emails treated as OWNER role seed
# at build time for the in-app RBAC UI. Non-secret; the server gateway remains
# the final enforcer once published. Empty = everyone resolves to VIEWER.
VITE_OWNER_EMAILS=

# Optional: same-origin base of the trusted OTP/session gateway for customer
# /account and the complementary employee OTP. The UI fails closed (no fake
# codes, no localStorage sessions) until this gateway is deployed.
# Defaults to /api/auth when unset.
VITE_AUTH_API_BASE=/api/auth

# Optional: endpoint accepting audited admin write actions (employee/role
# changes, catalog change packets). When unset, the admin UI produces
# formula-safe TSV change packets instead of pretending the write succeeded.
VITE_ADMIN_ACTIONS_WEBHOOK_URL=

# Optional analytics. Both values must be set for the tracker to be injected.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
