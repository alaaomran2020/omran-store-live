# Omran Store Live — static storefront environment template
# Production storefront: Vite + Cloudflare Pages + Google Sheet/public snapshot.
# No VPS, MySQL, Docker, Tunnel or custom application server.

# Public Google Sheet CSV used by the browser-side product loader when enabled.
# This is a public read-only URL, not a secret.
VITE_PRODUCTS_SHEET_URL=

# WhatsApp store number in international format without "+".
# Leave empty to hide WhatsApp ordering CTA instead of rendering a broken link.
VITE_WHATSAPP_NUMBER=

# Central hosted authentication endpoint for /admin.
# Required for username/password verification and cross-device employee approval.
# Passwords must never be placed in VITE_* variables, GitHub files, or Google Sheets.
VITE_ADMIN_AUTH_URL=

# Optional analytics. Both values must be set for the tracker to be injected.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
