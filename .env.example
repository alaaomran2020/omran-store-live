# =============================================================================
# Omran Store Live — environment template
#
# This list is the *complete* set of variables this codebase actually reads
# (verified by scanning every `process.env` / `import.meta.env` reference).
# Copy to `.env` and fill in; `.env` is git-ignored and .dockerignore keeps it
# out of the build context.
# =============================================================================

# ---------------------------------------------------------------------------
# كتالوج المنتجات — Google Sheets منشور كـCSV (المصدر الوحيد للمنتجات)
#
#   Google Sheets → File → Share → Publish to web → اختر الورقة →
#   Comma-separated values (.csv) → Publish → انسخ الرابط والصقه هنا.
#
# ليس مفتاح API ولا سرًا: رابط عام للقراءة فقط. لا Google API، لا OAuth،
# لا Service Account.
#
# أين يُضبط فعليًا في الإنتاج (Cloudflare):
#   PRODUCTS_SHEET_URL في [vars] داخل wrangler.toml  ← الأفضل (يقرأه الـWorker
#   على الحافة مع كاش 5 دقائق، فلا يطلب أي زائر الشيت مباشرة).
# البديل/الإضافي: VITE_PRODUCTS_SHEET_URL وقت البناء، فيقرأ المتصفح الشيت
# مباشرةً إذا لم يكن الـWorker مضبوطًا (يفيد لو نُشر الموقع كملفات ثابتة فقط).
# ---------------------------------------------------------------------------
PRODUCTS_SHEET_URL=
VITE_PRODUCTS_SHEET_URL=

# رقم واتساب المتجر بالصيغة الدولية بدون "+" (مثال: 201000000000).
# اتركه فارغًا ليختفي زر "اطلب عبر واتساب" بدل أن يقود لرابط مكسور.
# متغيّر وقت بناء (VITE_*): مرّره كـ --build-arg مثل متغيرات التحليلات.
VITE_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Facebook / Instagram product-feed sync (GET /api/social/feed)
# اختياري تمامًا وغير مطلوب للكتالوج: يبقى كما هو لروابط/تبويبات التواصل.
# Server-side only — tokens never reach the browser. Each platform is optional
# and independent; leave unset to show the professional empty state instead.
# In the Cloudflare deployment set these as WORKER SECRETS, not in this file:
#   wrangler secret put INSTAGRAM_ACCESS_TOKEN
#   wrangler secret put FACEBOOK_PAGE_ID
#   wrangler secret put FACEBOOK_PAGE_ACCESS_TOKEN
# See docs/META-SYNC-SETUP.md for how to obtain long-lived tokens.
# ---------------------------------------------------------------------------
# Instagram (Instagram API with Instagram Login) long-lived user token.
INSTAGRAM_ACCESS_TOKEN=
# Facebook Page numeric id + a long-lived Page access token.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
# Port is bound exactly as given in production (no auto-increment) because the
# Cloudflare Tunnel ingress targets a fixed upstream.
PORT=3000
# Max parsed request body. Uploads go direct-to-storage via presigned URLs and
# never traverse this process, so keep this small: it is a memory-amplification
# control, not an upload limit.
BODY_LIMIT=1mb

# ---------------------------------------------------------------------------
# Database (MySQL via Drizzle; lazily connected, so the app still boots without)
# ---------------------------------------------------------------------------
# Docker Compose uses the internal hostname `mysql`. URL-encode special
# characters in the password when placing it inside DATABASE_URL.
MYSQL_DATABASE=omran_store
MYSQL_USER=omran_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=mysql://omran_app:URL_ENCODED_PASSWORD@mysql:3306/omran_store

# ---------------------------------------------------------------------------
# Auth / sessions
# ---------------------------------------------------------------------------
# Signs the session JWT. Generate: openssl rand -hex 32
JWT_SECRET=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
# openId of the account granted the `admin` role on first sign-in
OWNER_OPEN_ID=

# ---------------------------------------------------------------------------
# لوحة إدارة المدراء — مصادقة واتساب OTP + RBAC (server/adminRoutes.ts)
#
# لا كلمات مرور: الهوية = رقم واتساب (E.164) + كود لمرة واحدة عبر قالب
# Meta WhatsApp Cloud API. كل الأسرار تُخزَّن في قاعدة البيانات كـ SHA-256
# مع AUTH_PEPPER، والجلسة Cookie HttpOnly.
#
# التشغيل في وضع التطوير (بدون DATABASE_URL وبدون WHATSAPP_TOKEN):
#   ADMIN_PHONE=+201000000000 ADMIN_NAME=المالك AUTH_DEV_MODE=1 npm run dev
#   ← المخزن في الذاكرة + الكود يظهر في شاشة الدخول مباشرة.
# في الإنتاج تُضبط أسرار واتساب كـ env على حاوية الخادم (وليست في wrangler.toml
# أبدًا — الـWorker يمرر /api/admin/* إلى الأصل ولا يرى هذه الأسرار).
# ---------------------------------------------------------------------------
# "فلفل" أمني يُخلط مع كل hash سرّي. إلزامي في الإنتاج. Generate: openssl rand -hex 32
AUTH_PEPPER=
# حساب مدير مبدئي يُزرع في مخزن الذاكرة (تطوير/معاينة بلا قاعدة بيانات فقط)
ADMIN_PHONE=
ADMIN_NAME=
ADMIN_ROLE=super_admin
# اختياري: JSON array من الصلاحيات — ["*"] للمدير العام، أو
# ["products.name","products.price","products.description","products.images"]
ADMIN_PERMISSIONS=
# مزوّد واتساب: meta | dev (الافتراضي dev إن لم يوجد توكن)
WHATSAPP_PROVIDER=
# رمز وصول دائم من Meta App (أسرار — لا تضعها في wrangler.toml)
WHATSAPP_TOKEN=
# معرّف رقم العمل في WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
# اسم قالب authentication المعتمد في Meta (افتراضي omran_admin_login)
WHATSAPP_OTP_TEMPLATE=omran_admin_login
# لغة القالب (افتراضي ar)
WHATSAPP_TEMPLATE_LANG=ar
# رمز التحقق لاشتراك الـ Webhook (Meta Dashboard → Webhook → Verify token)
WHATSAPP_VERIFY_TOKEN=
# سر التطبيق للتحقق من X-Hub-Signature-256
WHATSAPP_APP_SECRET=
# 1 = إرجاع كود التطوير في استجابة الطلب (تطوير فقط! لا تفعّله في الإنتاج)
AUTH_DEV_MODE=

# ---------------------------------------------------------------------------
# Host service bindings (Manus forge: storage presigning + owner notification)
# Required by /manus-storage/* and system.notifyOwner; leave unset to disable.
# ---------------------------------------------------------------------------
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# ---------------------------------------------------------------------------
# Optional: Umami analytics. Both must be set or the <script> tag is not
# injected at all (a half-filled tag used to emit a literal
# "%VITE_ANALYTICS_ENDPOINT%/umami" request on every page view).
# Build-time only: they are baked into dist/public/index.html, so pass them as
# `--build-arg` (see Dockerfile), not as runtime env.
# ---------------------------------------------------------------------------
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ---------------------------------------------------------------------------
# Hybrid topology (client on Workers Assets, API in this container).
# Set true ONLY once the edge (wrangler.toml) is deployed and is the public
# hostname: this origin then answers /api/* and /manus-storage/* and returns
# 404 for everything else, so the tunnel hostname can never serve a second copy
# of the SPA (which would bypass the edge's cache/header policy).
# Keep false for a pure-VPS deploy, where this process serves dist/public.
# ---------------------------------------------------------------------------
EDGE_ONLY=false

# ---------------------------------------------------------------------------
# Cloudflare Tunnel — remote-managed tunnel token (dashboard → Networks →
# Routes → Tunnels). Leave unset if you run cloudflared outside this compose
# project with a credentials-file + config.yml instead.
# ---------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
